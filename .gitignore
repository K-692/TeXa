# ==============================================================================
# TeXa Root Git Ignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# AI Models Storage
# The models folder remains empty in the repository; local weights are not tracked.
models/*
!models/.gitkeep

# Frontend Build & Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.oxlintcache

# LaTeX Auxiliary & Compilation Output Files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.dvi
*.xdv

# Generated PDF artifacts in project workspaces
projects/*.pdf
projects/*.synctex.gz
projects/*.aux
projects/*.log
projects/*.out

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Text Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

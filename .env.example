# ==============================================================================
# TeXa Environment Configuration (Example Template)
# Copy this file to .env and fill in your settings.
# ==============================================================================

# Hugging Face Access Token
# Required for downloading gated/authenticated models (e.g., google/gemma-3-1b-it, meta-llama/Llama-3.2-3B-Instruct)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Default LaTeX Workspace Directory
# Can be a relative path (e.g. ./projects) or an absolute path (e.g. ~/TeXa_Projects)
WORKING_DIRECTORY=./projects
